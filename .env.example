# Candidate link asks for this password. Share it by email. At least 8 characters.
INTERVIEW_PASSWORD=change-this-candidate-password

# Admin dashboard password. Must be different from INTERVIEW_PASSWORD.
# Candidates who know the interview password must not be able to open /admin.
ADMIN_PASSWORD=change-this-admin-password

# https://console.perplexity.ai — server only, never put this in the browser.
PERPLEXITY_API_KEY=

# Strong default. Other ids: openai/gpt-5.6-terra, anthropic/claude-opus-4-6, xai/grok-4.7
PERPLEXITY_MODEL=anthropic/claude-sonnet-4-6

# Comma-separated fallbacks if the first model is unavailable.
PERPLEXITY_FALLBACK_MODELS=openai/gpt-5.6-terra,google/gemini-3.1-pro-preview

PORT=8787

# How many main questions (4–10). Each can have up to 2 follow-ups.
QUESTION_COUNT=6
COMPANY_NAME=Your Company
TARGET_ROLE=Software Engineer
INTERVIEW_LANGUAGE=English
# Extra hiring focus. You can also edit this later in the admin page.
FOCUS_NOTES=Probe real project decisions, tradeoffs, failures, and fundamentals. Do not accept buzzwords without a mechanism.

# Strikes before the interview is closed. Tab switch, second face, leaving fullscreen, and so on.
MAX_STRIKES=3

# Google OAuth desktop client. Needed so recordings land in YOUR Drive quota.
# Create at https://console.cloud.google.com/apis/credentials (Application type: Desktop).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional. `npm run drive-login` writes data/google-oauth.json instead.
# Set these only when the server runs somewhere else and you copy the login result.
GOOGLE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=

# Optional Workspace path. A service account has no storage of its own.
# Use this only with a Shared Drive, and share the folder with the service account email.
# Paste the JSON on one line, or set a path to the json file.
GOOGLE_SERVICE_ACCOUNT_JSON=
